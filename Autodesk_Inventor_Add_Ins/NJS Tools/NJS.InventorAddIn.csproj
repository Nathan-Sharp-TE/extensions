<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableComHosting>true</EnableComHosting>
    <AssemblyName>NJS.InventorAddIn</AssemblyName>
    <RootNamespace>NJS.InventorAddIn</RootNamespace>
    <Company>NJS</Company>
    <Product>NJS Tools for Autodesk Inventor</Product>
    <InventorBinPath Condition="'$(InventorBinPath)' == ''">C:\Program Files\Autodesk\Inventor 2026\Bin</InventorBinPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorBinPath)\Autodesk.Inventor.Interop.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="stdole">
      <HintPath>$(InventorBinPath)\stdole.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateInventorInterop" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(InventorBinPath)\Autodesk.Inventor.Interop.dll')"
           Text="Inventor API not found at '$(InventorBinPath)'. Set InventorBinPath to the Inventor 2026 Bin folder." />
  </Target>
</Project>
